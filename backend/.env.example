# Skopiuj do backend/.env i dostosuj w razie potrzeby.

# Nazwa i środowisko aplikacji
APP_NAME="SmartRoute AI"
ENVIRONMENT=development
DEBUG=false

# Baza danych (SQLite). Ścieżka względna liczona od katalogu uruchomienia.
DATABASE_URL=sqlite:///./smartroute.db

# Dozwolone originy CORS — lista rozdzielona przecinkami (domyślnie Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Parametry modelu szacunkowego (opcjonalne) ---
# Wartości domyślne to PRZYJĘTE ZAŁOŻENIA, nie bieżące ceny ani oficjalne taryfy.
# Opis i jednostki każdego pola: app/core/transport_params.py
# TRANSPORT__CAR__AVG_SPEED_KMH=40
# TRANSPORT__CAR__PARKING_TIME_MIN=5
# TRANSPORT__CAR__FUEL_CONSUMPTION_L_PER_100KM=7.0
# TRANSPORT__CAR__FUEL_PRICE_PLN_PER_L=6.50
# TRANSPORT__CAR__CO2_KG_PER_KM=0.17
# TRANSPORT__PUBLIC_TRANSPORT__AVG_SPEED_KMH=22
# TRANSPORT__PUBLIC_TRANSPORT__ACCESS_WAIT_TIME_MIN=8
# TRANSPORT__PUBLIC_TRANSPORT__BASE_TICKET_PLN=4.40
# TRANSPORT__PUBLIC_TRANSPORT__BASE_TICKET_MAX_KM=10
# TRANSPORT__PUBLIC_TRANSPORT__EXTRA_PLN_PER_KM=0.25
# TRANSPORT__PUBLIC_TRANSPORT__CO2_KG_PER_PASSENGER_KM=0.05
# TRANSPORT__BIKE__AVG_SPEED_KMH=15
# TRANSPORT__BIKE__MAX_DISTANCE_KM=20
