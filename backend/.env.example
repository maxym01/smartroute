# Skopiuj do backend/.env i dostosuj w razie potrzeby.

# Nazwa i środowisko aplikacji
APP_NAME="SmartRoute AI"
ENVIRONMENT=development
DEBUG=false

# Baza danych (SQLite). Ścieżka względna liczona od katalogu uruchomienia.
DATABASE_URL=sqlite:///./smartroute.db

# Dozwolone originy CORS — lista rozdzielona przecinkami (domyślnie Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
