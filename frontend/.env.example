# Skopiuj do frontend/.env.local w razie potrzeby.

# Adres backendu, do którego dev server Vite przekazuje żądania /api (proxy).
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Opcjonalnie: pełny adres API, gdy frontend jest serwowany bez proxy (np. inny host).
# Wymaga dodania originu frontendu do CORS_ORIGINS w backend/.env.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
